{
  "expo": {
    "name": "Escolta UNITAU",
    "slug": "escolta-unitau",
    "scheme": "escolta",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "O app precisa de Bluetooth para conectar ao Escolta UNITAU"
        }
      ],
      "expo-font",
      "./tools/plugins/with-test-build.cjs",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "escolta_emergencias_v3"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se você ativar essa opção, o Escolta poderá incluir a localização deste celular no início de uma emergência."
        }
      ]
    ],
    "android": {
      "versionCode": 3,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.nicolasvmen.escoltaunitau"
    },
    "extra": {
      "eas": {
        "projectId": "be41ccc5-f32b-428e-9974-91dffc0fed45"
      }
    }
  }
}
