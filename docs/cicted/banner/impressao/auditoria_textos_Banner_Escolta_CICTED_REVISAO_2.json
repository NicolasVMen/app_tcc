  {
    "name": "TextBox 1030",
    "text": "ESCOLTA UNITAU: PROTÓTIPO VESTÍVEL PARA MONITORAMENTO DE PROXIMIDADE INFANTIL POR BLUETOOTH LOW ENERGY",
    "height": 399.6,
