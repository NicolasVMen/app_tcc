# ID público do cliente OAuth do tipo WEB, no projeto escolta-unitau.
# Não inserir segredo de cliente, senha ou chave privada neste arquivo.
# Sem ele, o botão Google permanece indisponível, e e-mail/senha continuam ativos.
# Usado por teste e oficial; cada pacote Android precisa de cadastro e SHA próprios.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Ferramentas internas: somente cliente de desenvolvimento Escolta Teste.
# true habilita ensaios, diagnósticos e testes manuais. Ausente/false mantém ocultos.
# Mesmo true é ignorado em APK release e na identidade oficial.
EXPO_PUBLIC_ENABLE_INTERNAL_TOOLS=false

# Coletor passivo A1: opt-in de compilação, independente dos testes ativos.
# Exige monitor validado; não inicia coleta sozinho e não aciona alarmes.
# O perfil oficial-validada fixa false; autonomia-instrumentada fixa true.
EXPO_PUBLIC_ENABLE_BATTERY_STUDY=false
