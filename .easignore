# Enviar somente fontes/recursos de compilação. Não enviar TCC, fotos, CSV ou backups.
/*
!/App.tsx
!/src
!/src/**
!/assets
!/assets/**
!/modules
!/modules/**
!/tools
/tools/*
!/tools/plugins
!/tools/plugins/**
!/tools/android
!/tools/android/**
!/package.json
!/package-lock.json
!/app.json
!/eas.json
!/tsconfig.json
!/babel.config.js
!/metro.config.js
!/.npmrc
!/.easignore

# Defesa adicional também dentro das pastas permitidas.
**/node_modules/
**/build/
**/.gradle/
**/.git/
**/.env*
**/credentials.json
**/google-services.json
**/GoogleService-Info.plist
**/*.jks
**/*.keystore
**/*.key
**/*.p12
**/*.log
